# ========================
# 数据库配置 (MySQL)
# ========================
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=127.0.0.1
DB_PORT=3306

# ========================
# LLM 中转网关 API 密钥（OpenAI 接口规范）
# ========================
BUPT_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_GATEWAY_API_KEY=
LLM_CHAT_BASE_URL=https://llm-gw.bupt.edu.cn/v1/chat/completions
LLM_EMBEDDING_BASE_URL=https://llm-gw.bupt.edu.cn/v1/embeddings

# ========================
# 模型配置（统一走中转网关）
# ========================
# 通用 LLM 模型 (用于对话、简单任务)
LLM_MODEL_UTILITY=deepseek-medium
# 推理 LLM 模型 (用于复杂推理、重排)
LLM_MODEL_REASONING=qwen-latest
# 结构化抽取模型（文件解析）
LLM_MODEL_EXTRACTION=qwen-medium
# Embedding 模型
EMBEDDING_MODEL=bge-large-zh-v1.5
TEXT_EMBEDDING_MODEL=bge-large-zh-v1.5
TEXT_EMBEDDING_DIM=1024

# ========================
# Milvus 配置
# ========================
MILVUS_HOST=localhost
MILVUS_PORT=19530

# ========================
# LangSmith Tracing (可选)
# ========================
LANGCHAIN_TRACING_V2=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=lsv2_pt_xxxxxxxxxxxxxxxxxxxxxxxx
LANGCHAIN_PROJECT=Server_Project_ZH
